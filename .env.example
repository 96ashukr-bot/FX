DJANGO_SETTINGS_MODULE=config.settings
SECRET_KEY=replace-me
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1,forex.example.com
CSRF_TRUSTED_ORIGINS=https://forex.example.com
CORS_ALLOWED_ORIGINS=https://forex.example.com
POSTGRES_DB=fx
POSTGRES_USER=fx
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgresql://fx:fx@postgres:5432/fx
REDIS_URL=redis://redis:6379/0
PUBLIC_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173
FIELD_ENCRYPTION_KEY=replace-with-a-32-byte-key
WEBHOOK_CLOCK_SKEW_SECONDS=300
TERMINAL_COMMAND_TTL_SECONDS=30
